{
  "$schema": "Design tokens for Reliability Lab promotional website",
  "$description": "Matches the print poster design system. Industrial Dark + Clean Professional aesthetic.",

  "colors": {
    "background": {
      "primary": "#0A1628",
      "secondary": "#1A2332",
      "lightPlate": "#FFFFFF"
    },
    "accent": {
      "panasonicBlue": "#00AEEF",
      "panasonicBlueHover": "#0090C5",
      "industrialAmber": "#FFA726",
      "industrialAmberHover": "#E69517"
    },
    "text": {
      "primary": "#FFFFFF",
      "secondary": "#8B95A7",
      "muted": "#5A6478",
      "onLight": "#0A1628"
    },
    "border": {
      "subtle": "rgba(0, 174, 239, 0.08)",
      "card": "rgba(255, 255, 255, 0.06)",
      "focus": "#00AEEF"
    },
    "status": {
      "success": "#1A8F4E",
      "warning": "#FFA726",
      "error": "#C0392B"
    }
  },

  "typography": {
    "fontFamilies": {
      "hero": ["Inter", "Barlow Condensed", "system-ui", "sans-serif"],
      "body": ["Inter", "Helvetica Neue", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "Space Mono", "Courier New", "monospace"]
    },
    "fontSize": {
      "hero": { "value": "4.5rem", "lineHeight": "1.1", "letterSpacing": "-0.02em" },
      "h1": { "value": "3rem", "lineHeight": "1.15" },
      "h2": { "value": "2.25rem", "lineHeight": "1.2" },
      "h3": { "value": "1.5rem", "lineHeight": "1.3" },
      "specNumber": { "value": "3rem", "lineHeight": "1", "fontFamily": "mono" },
      "body": { "value": "1rem", "lineHeight": "1.6" },
      "small": { "value": "0.875rem", "lineHeight": "1.5" },
      "label": { "value": "0.75rem", "lineHeight": "1.4", "letterSpacing": "0.1em", "textTransform": "uppercase" }
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },

  "spacing": {
    "base": "4px",
    "scale": {
      "xs": "0.5rem",
      "sm": "0.75rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem",
      "4xl": "6rem",
      "5xl": "8rem"
    }
  },

  "borderRadius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "card": "8px",
    "full": "9999px"
  },

  "shadows": {
    "card": "0 4px 20px rgba(0, 0, 0, 0.4)",
    "cardHover": "0 8px 30px rgba(0, 174, 239, 0.15)",
    "glow": "0 0 20px rgba(0, 174, 239, 0.3)"
  },

  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },

  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "easeOut": "cubic-bezier(0, 0, 0.2, 1)",
      "easeInOut": "cubic-bezier(0.4, 0, 0.2, 1)"
    }
  },

  "effects": {
    "gridOverlay": {
      "description": "Subtle technical grid background pattern",
      "color": "#00AEEF",
      "opacity": 0.08,
      "size": "40px"
    },
    "cornerBrackets": {
      "description": "L-shaped accent brackets at section corners",
      "color": "#00AEEF",
      "strokeWidth": "1px",
      "length": "20px"
    }
  }
}
